# ====================================================================
# SkyStream Client - Environment Configuration Example
# Copy this file to .env and adjust variables as needed.
# ====================================================================

# Backend API URL (Leave blank for relative /api reverse proxy or set to Render backend)
# Local: http://localhost:5000
# Production on Render: https://skystream-backend.onrender.com
VITE_API_URL=http://localhost:5000

# Socket.IO server URL for real-time notifications
# Local: http://localhost:5000
# Production on Render: https://skystream-backend.onrender.com
VITE_SOCKET_URL=http://localhost:5000
