# ====================================================================
# SkyStream Docker Compose - Environment Configuration Example
# Copy this file to .env at the root of the project to customize.
# ====================================================================

# Port mappings on host
CLIENT_PORT=5173
SERVER_PORT=5000

# Backend Configuration
NODE_ENV=production
MONGODB_URI=mongodb://host.docker.internal:27017/skystream
JWT_SECRET=replace_with_a_secure_random_jwt_secret_minimum_32_characters
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
