# ====================================================================
# SkyStream Server - Environment Configuration Example
# Copy this file to .env and adjust variables as needed.
# ====================================================================

# Port for the Node.js Express server (automatically set on Render)
PORT=5000

# Runtime environment (development | production | test)
NODE_ENV=production

# MongoDB Connection URI:
# 1. Local Windows development (without Docker):
# MONGODB_URI=mongodb://127.0.0.1:27017/skystream?replicaSet=rs0
#
# 2. Local Docker container connecting to Windows-hosted MongoDB:
# MONGODB_URI=mongodb://host.docker.internal:27017/skystream
#
# 3. Production MongoDB Atlas Cluster (Configure in Render Dashboard):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/skystream?retryWrites=true&w=majority
MONGODB_URI=mongodb://host.docker.internal:27017/skystream

# JWT Secret for signing authentication tokens (Required: Minimum 32 random characters)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_minimum_32_characters

# JWT expiration duration
JWT_EXPIRES_IN=7d

# Allowed frontend client origin for CORS & Socket.IO (comma-separated if multiple)
# In production on Render: https://skystream-frontend.onrender.com
CLIENT_ORIGIN=http://localhost:5173
